---
/**
 * Illustration signature : un bureau dont le plateau monte et descend entre
 * les deux plages de hauteur de travail indiquées par l’INRS
 * (68 à 76 cm assis, 107 à 115 cm debout). Échelle : 2 px = 1 cm.
 */
const floor = 340;
const cm = (v: number) => floor - v * 2;
const ticks = Array.from({ length: 15 }, (_, i) => i * 10);
---

<svg
  class="desk-art"
  viewBox="0 0 440 360"
  role="img"
  aria-labelledby="desk-art-title desk-art-desc"
>
  <title id="desk-art-title">Bureau assis-debout et repères de hauteur</title>
  <desc id="desk-art-desc">
    Schéma d’un bureau à hauteur variable. Une règle graduée indique la plage
    de 68 à 76 cm pour le travail assis et celle de 107 à 115 cm pour le travail
    debout, selon l’INRS.
  </desc>

  <!-- Fenêtre, lumière de journée -->
  <g>
    <rect x="292" y="0" width="140" height="210" rx="6" style="fill: var(--card); stroke: var(--line)" />
    <path d="M362 0v210M292 105h140" style="stroke: var(--line)" />
    <rect x="292" y="0" width="140" height="210" rx="6" style="fill: url(#light)" />
  </g>

  <defs>
    <linearGradient id="light" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#e3b98f" stop-opacity="0.35" />
      <stop offset="1" stop-color="#e3b98f" stop-opacity="0" />
    </linearGradient>
  </defs>

  <!-- Sol -->
  <path d={`M0 ${floor}H440`} style="stroke: var(--line-strong)" stroke-width="1.5" />

  <!-- Règle graduée -->
  <g>
    <rect x="30" y={cm(140)} width="14" height={140 * 2} rx="2" style="fill: var(--card); stroke: var(--line-strong)" />
    {
      ticks.map((t) => (
        <path
          d={`M30 ${cm(t)}h${t % 50 === 0 ? 10 : 6}`}
          style="stroke: var(--ink-2)"
          stroke-width="1"
        />
      ))
    }
    <rect x="30" y={cm(115)} width="14" height="16" style="fill: var(--sapin)" opacity="0.9" />
    <rect x="30" y={cm(76)} width="14" height="16" style="fill: var(--oak)" />

    <g class="label-stand">
      <path d={`M48 ${cm(111)}h10`} style="stroke: var(--sapin)" stroke-width="1.5" />
      <text x="62" y={cm(111) - 3} style="fill: var(--ink); font: 600 12px var(--font-body)">Debout</text>
      <text x="62" y={cm(111) + 12} style="fill: var(--ink-2); font: 400 11px var(--font-body)">107 à 115 cm</text>
    </g>
    <g class="label-sit">
      <path d={`M48 ${cm(72)}h10`} style="stroke: var(--oak)" stroke-width="1.5" />
      <text x="62" y={cm(72) - 3} style="fill: var(--ink); font: 600 12px var(--font-body)">Assis</text>
      <text x="62" y={cm(72) + 12} style="fill: var(--ink-2); font: 400 11px var(--font-body)">68 à 76 cm</text>
    </g>
  </g>

  <!-- Partie mobile : plateau, colonnes internes, poste de travail -->
  <g class="rise">
    <!-- Colonnes internes (télescopiques) -->
    <rect x="194" y="128" width="12" height="124" style="fill: #4a4640" />
    <rect x="364" y="128" width="12" height="124" style="fill: #4a4640" />

    <!-- Traverse et boîtier de commande -->
    <rect x="190" y="128" width="190" height="6" style="fill: var(--steel)" />
    <rect x="160" y="128" width="20" height="7" rx="1.5" style="fill: var(--steel)" />
    <circle cx="166" cy="131.5" r="1.3" style="fill: var(--oak-light)" />
    <circle cx="173" cy="131.5" r="1.3" style="fill: var(--oak-light)" />

    <!-- Plateau chêne + chant acier -->
    <rect x="150" y="117" width="270" height="11" rx="1.5" style="fill: var(--oak)" />
    <path d="M150 127.5h270" style="stroke: var(--steel)" stroke-width="2" />
    <path d="M178 121h60M262 123h80" style="stroke: #b48d55" stroke-width="0.8" stroke-linecap="round" />

    <!-- Plante -->
    <path d="M166 117l-3-16h22l-3 16z" style="fill: var(--cuivre)" />
    <path d="M174 101c-10-6-12-18-8-26 6 6 9 15 8 26Zm0 0c4-12 12-18 20-18-2 9-9 16-20 18Zm0 0c-4-8-14-10-20-8 4 7 11 10 20 8Z" style="fill: var(--sapin)" />

    <!-- Écran -->
    <rect x="276" y="92" width="8" height="22" style="fill: var(--steel)" />
    <rect x="260" y="113" width="40" height="4" rx="1.5" style="fill: var(--steel)" />
    <rect x="218" y="36" width="124" height="60" rx="4" style="fill: var(--steel)" />
    <rect x="223" y="41" width="114" height="50" rx="2" style="fill: var(--night)" />
    <path d="M232 54h52M232 63h80M232 72h64M232 81h40" style="stroke: var(--ink-on-night-2)" stroke-width="2.5" stroke-linecap="round" opacity="0.55" />

    <!-- Clavier, tasse -->
    <rect x="196" y="112" width="54" height="5" rx="1.5" style="fill: var(--card); stroke: var(--line-strong)" />
    <rect x="380" y="104" width="14" height="13" rx="2" style="fill: var(--card); stroke: var(--line-strong)" />
    <path d="M394 108c5 0 5 6 0 6" style="stroke: var(--line-strong)" fill="none" />
  </g>

  <!-- Colonnes fixes et pieds -->
  <rect x="190" y="236" width="20" height="100" rx="1.5" style="fill: var(--steel)" />
  <rect x="360" y="236" width="20" height="100" rx="1.5" style="fill: var(--steel)" />
  <rect x="164" y="334" width="72" height="6" rx="3" style="fill: var(--steel)" />
  <rect x="334" y="334" width="72" height="6" rx="3" style="fill: var(--steel)" />
</svg>
