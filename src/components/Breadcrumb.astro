---
import type { Crumb } from '../data/silos';
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Fil d’Ariane">
  <ol>
    {
      items.map((item) =>
        item.href ? (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ) : (
          <li>
            <span aria-current="page">{item.label}</span>
          </li>
        ),
      )
    }
  </ol>
</nav>
