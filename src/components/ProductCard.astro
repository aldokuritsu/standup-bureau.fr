---
import type { Product } from '../data/products';
import {
  amazonProductUrl,
  amazonImageUrl,
} from '../data/products';

interface Props {
  product: Product;
  showBuy?: boolean;
  /** Prefill compare tool with this model as side A */
  compareHref?: string;
}

const { product, showBuy = true, compareHref } = Astro.props;
const kindLabel =
  product.kind === 'bureau-complet' ? 'Bureau complet' : 'Cadre seul';
const ratingLabel =
  product.ratingCount > 0
    ? `${product.rating.toFixed(1).replace('.', ',')}/5 · ${product.ratingCount.toLocaleString('fr-FR')} avis (${product.ratingCheckedAt})`
    : `${product.rating.toFixed(1).replace('.', ',')}/5 (${product.ratingCheckedAt})`;
const img = amazonImageUrl(product.imageId, 'md');
const buy = amazonProductUrl(product.asin);
const compare =
  compareHref ?? `/bureaux/comparer/?a=${encodeURIComponent(product.slug)}`;
---

<article class="product-card">
  <a class="product-card__media" href={buy} rel="sponsored noopener" target="_blank">
    <img
      src={img}
      alt={`${product.shortName} : vue produit`}
      width="500"
      height="500"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="product-card__meta">
    <span class="product-card__kind">{kindLabel}</span>
    <span class="product-card__brand">{product.brand}</span>
  </div>
  <h3 class="product-card__title">
    <a href={`/bureaux/${product.slug}/`}>{product.shortName}</a>
  </h3>
  <p class="product-card__rating">{ratingLabel}</p>
  <p class="product-card__blurb">{product.blurb}</p>
  <dl class="product-card__specs">
    <div>
      <dt>Hauteur</dt>
      <dd>{product.heightRange}</dd>
    </div>
    <div>
      <dt>Charge</dt>
      <dd>{product.loadKg}&nbsp;kg</dd>
    </div>
    <div>
      <dt>Format</dt>
      <dd>{product.size}</dd>
    </div>
  </dl>
  <div class="product-card__actions">
    <a class="text-link" href={compare}>Comparer</a>
    {
      showBuy && (
        <a
          class="btn btn--buy btn--buy-sm"
          href={buy}
          rel="sponsored noopener"
          target="_blank"
        >
          Voir l’offre <small>(lien affilié)</small>
        </a>
      )
    }
  </div>
</article>
